# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# ASP.NET Core build outputs
app/backend/**/bin/
app/backend/**/obj/
app/backend/publish/
app/backend/publish-selfcontained/
app/backend/**/publish/
app/backend/**/publish-selfcontained/

# Sensitive backend configuration
app/backend/appsettings.json
app/backend/appsettings.*.json
!app/backend/appsettings.example.json

# Logs and temporary files
app/backend/logs/
app/backend/**/*.log
*.db
*.sqlite
*.sqlite3

# Publish archives
publish.zip
publish-selfcontained.zip

